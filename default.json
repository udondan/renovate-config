{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate config for udondan repositories",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests"
  ],
  "semanticCommits": "enabled",
  "labels": ["renovate"],
  "minimumReleaseAge": "3 days",
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "rebaseWhen": "behind-base-branch",
  "prHourlyLimit": 10,
  "lockFileMaintenance": { "enabled": true },
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**"
  ],
  "packageRules": [
    {
      "description": "Exact versions in package.json.",
      "matchManagers": ["npm"],
      "matchDepTypes": [
        "dependencies",
        "devDependencies",
        "optionalDependencies"
      ],
      "rangeStrategy": "pin"
    },
    {
      "description": "Keep Cargo.toml in sync with Cargo.lock.",
      "matchManagers": ["cargo"],
      "rangeStrategy": "bump"
    },
    {
      "description": "ESLint plugins and configs have peer dependencies on eslint, typescript-eslint and prettier. Updated separately, npm fails with ERESOLVE.",
      "groupName": "lint tooling",
      "matchDatasources": ["npm"],
      "matchPackageNames": [
        "eslint",
        "@eslint/js",
        "typescript-eslint",
        "@typescript-eslint/**",
        "eslint-config-*",
        "eslint-plugin-*",
        "prettier"
      ]
    },
    {
      "description": "rubocop extensions depend on the rubocop version.",
      "groupName": "rubocop",
      "matchDatasources": ["rubygems"],
      "matchPackageNames": ["rubocop", "rubocop-*"]
    },
    {
      "description": "First-party actions keep their version tags. Third-party actions are pinned to a commit SHA.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["actions/**", "github/**"],
      "pinDigests": false
    }
  ]
}
